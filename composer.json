{
  "name": "feryardiant/laravel12-starterkit",
  "type": "project",
  "description": "Yet another Laravel Starter-Kit.",
  "keywords": [
    "laravel",
    "starter-kit",
    "inertia-react"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "fakerphp/faker": "^1.23",
    "inertiajs/inertia-laravel": "^2.0",
    "laravel/framework": "^12.0",
    "laravel/reverb": "^1.0",
    "laravel/sanctum": "^4.1",
    "laravel/tinker": "^2.10.1",
    "predis/predis": "^2.3",
    "pusher/pusher-php-server": "^7.2",
    "sentry/sentry-laravel": "^4.13",
    "tightenco/ziggy": "^2.5"
  },
  "require-dev": {
    "kitloong/laravel-migrations-generator": "^7.2",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.18",
    "laravel/sail": "^1.41",
    "laravel/telescope": "^5.5",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^3.7",
    "pestphp/pest-plugin-laravel": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "fix": [
      "pint"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=3\" \"php artisan queue:work database --queue=listeners\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --port=8001\" \"php artisan queue:listen --tries=3\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "ziggy:generate": [
      "@php artisan ziggy:generate resources/client --types-only"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
